# Example-only template for run.py
# Replace placeholder values (<...>) before using.

[run]
# output_dir = "<relative-or-absolute-output-path>"
# seed = <int>
# batch_size = <int>
# num_proc = <int>
# resume_from_partial = <true|false>
# write_predictions = <true|false>
# show_progress_bar = <true|false>  # false silences tqdm bars (smaller cluster logs)

[datasets.msmarco]
# enabled = <true|false>
# input_path = "<path-to-msmarco-data>"
# splits = ["<split-name-1>", "<split-name-2>"]
# language_pairs = [["cz", "cz"], ["cz", "en"], ["en", "cz"], ["en", "en"]]  # optional, defaults to all four
# limit = <int>
# reranking = <true|false>                             # optional second stage, see notes below
# reranking_model = "<huggingface-cross-encoder-id>"
# reranking_top_k = <int>                              # candidates per query, default 100

[datasets.ctdc_synthetic]
# enabled = <true|false>
# synthetic_path = "<path-to-ctdc-synthetic-json>"   # synthetic queries + relevant document ids
# corpus_dir = "<path-to-ctdc-corpus-dir>"           # directory containing a "sources/*.txt" folder
# query_limit = <int>   # max synthetic queries to evaluate (omit for all)
# corpus_limit = <int>  # extra distractor documents on top of the relevant ones (omit for all)
# reranking = <true|false>
# reranking_model = "<huggingface-cross-encoder-id>"   # e.g. "jinaai/jina-reranker-v3"
# reranking_top_k = <int>

# Reranking notes:
# - `enabled` runs first-stage retrieval, `reranking` runs the cross-encoder stage.
#   They are independent, so `enabled = false` with `reranking = true` rescores an
#   existing run without recomputing it.
# - The first-stage run is read from <output_dir>/<task>/<model>/ and is never
#   configured explicitly, so it must have been produced with
#   `write_predictions = true`. Missing predictions raise an error naming the path.
# - Results land in <output_dir>/<task>_rerank/<first-stage-model>/<reranker>/.

[mteb.multilingual]
# enabled = <true|false>
# include_tasks = ["<TaskName1>", "<TaskName2>"]

[[models]]
# name = "<huggingface-model-id>"
# normalize_embeddings = <true|false>
# use_safetensors = <true|false>
# max_seq_length = <int>  # optional truncation cap; only lowers a model's native limit

# Add more models by repeating [[models]] with the same keys.
# [[models]]
# name = "<another-huggingface-model-id>"
# normalize_embeddings = <true|false>
# use_safetensors = <true|false>
# trust_remote_code = <true|false>
# pooling_mode = "cls"

# For models too large to fit on a single GPU, set device_map = "auto" to let
# accelerate shard the model's backbone across all GPUs visible to the process.
# [[models]]
# name = "<large-huggingface-model-id>"
# normalize_embeddings = <true|false>
# use_safetensors = <true|false>
# trust_remote_code = <true|false>
# device_map = "auto"

# Ollama models: prefix the Ollama model tag with "ollama/".
# Requires a running Ollama server (OLLAMA_HOST, default http://localhost:11434).
# [[models]]
# name = "ollama/<ollama-model-tag>"
# normalize_embeddings = <true|false>
# use_safetensors = false
# trust_remote_code = false
# query_prompt = "<optional-query-prefix>"
# document_prompt = "<optional-document-prefix>"

#!/bin/bash
#PBS -N czech_embed_eval
#PBS -q gpu
#PBS -l select=1:ncpus=16:ngpus=2:gpu_mem=40gb:mem=128gb:scratch_local=150gb
#PBS -l walltime=48:00:00
#PBS -j oe
#PBS -m abe
#PBS -M roman.tomchik953@student.cuni.cz
#PBS -o /storage/praha1/home/rtomchik/czech_embedding_benchmark/jobs/logs/

# Runs the retrieval evaluation for a single (small) model on MetaCentrum.
#
# Usage:
#   qsub -v CONFIG=configs/per_model/intfloat_multilingual-e5-small.toml jobs/scripts/run_metacentrum.pbs
#
# CONFIG may be absolute or relative to the repository root. Results are
# written by evaluation/evaluate.py to results/mteb/... exactly as usual.

set -euo pipefail

REPO="/storage/praha1/home/rtomchik/czech_embedding_benchmark"
LOG_DIR="$REPO/jobs/logs"

# Mirror all output to a shared logfile so progress is visible while the job runs.
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/${PBS_JOBID:-local}.log"
exec > >(tee -a "$LOG_FILE") 2>&1

# --- Validate input -----------------------------------------------------
if [[ -z "${CONFIG:-}" ]]; then
    echo "ERROR: CONFIG not set. Submit with: qsub -v CONFIG=<path/to/config.toml> $0" >&2
    exit 1
fi

CONFIG_PATH="$CONFIG"
[[ "$CONFIG_PATH" != /* ]] && CONFIG_PATH="$REPO/$CONFIG_PATH"

if [[ ! -f "$CONFIG_PATH" ]]; then
    echo "ERROR: config file not found: $CONFIG_PATH" >&2
    exit 1
fi

# --- Scratch for caches/temp (results stay on /storage) -----------------
trap 'clean_scratch' TERM EXIT
export TMPDIR="$SCRATCHDIR/tmp"
export HF_HOME="$SCRATCHDIR/hf"
export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
mkdir -p "$TMPDIR" "$HF_HOME"

# --- Environment ---------------------------------------------------------
cd "$REPO"
source venvs/.venv/bin/activate

echo "Job:      ${PBS_JOBID:-local}"
echo "Node:     $(hostname)"
echo "Config:   $CONFIG_PATH"
echo "Started:  $(date)"

# --- Run evaluation (writes results to results/ in the repo) -------------
python evaluation/evaluate.py --config "$CONFIG_PATH"

echo "Finished: $(date)"
